{
  "name": "reset-radar",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "npm run build:widget && npm run verify:widget && next dev",
    "build": "npm test && npm run build:widget && npm run verify:widget && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:widget": "vite build",
    "verify:widget": "node scripts/verify-widget.mjs",
    "test": "node --import tsx --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "mcp-handler": "^2.0.0",
    "next": "^16.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "tsx": "^4.20.6"
  },
  "engines": {
    "node": ">=20"
  }
}
